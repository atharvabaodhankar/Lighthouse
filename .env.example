# Pi-hole connection settings
# When deployed on AWS EC2 alongside Pi-hole: http://127.0.0.1:8080 (or http://pihole:80 in Docker)
PIHOLE_URL=http://127.0.0.1:8080
PIHOLE_API_TOKEN=

# Force simulation mode (auto-enabled if Pi-hole is not reachable)
MOCK_MODE=false

# Telegram daily report / alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server runtime
HOST=0.0.0.0
PORT=8000
DEBUG=false

